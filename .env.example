# Copy to .env and fill in. Nothing here is needed for Increment 0 (domain + check).

# --- Increment 2: persistence ---
# Postgres connection string (docker-compose provides one locally).
DATABASE_URL=

# --- Increment 1: offers (Channel3) ---
# https://docs.trychannel3.com — header x-api-key. GET /v1/products/{id} is free; search costs 1 credit.
CHANNEL3_API_KEY=

# --- Increment 3: PayPal sandbox ---
# REST app with "Vault" ticked under Accept payments → Advanced options.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the developer dashboard; required by verify-webhook-signature.
PAYPAL_WEBHOOK_ID=

# --- Increment 5: steering classifier ---
ANTHROPIC_API_KEY=

# --- Increment 8: bench, second provider ---
OPENAI_API_KEY=

# --- Server ---
# 32 random bytes, base64. Encrypts vault ids at rest. Generate: openssl rand -base64 32
SLIP_ENCRYPTION_KEY=
# Public base URL used for PayPal return_url / cancel_url and webhook registration.
SLIP_BASE_URL=http://localhost:3000

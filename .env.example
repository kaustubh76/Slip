# Copy to .env and fill in. `pnpm test` needs none of this.

# --- Persistence ---
# One of:
#   postgres://slip:slip@localhost:54329/slip   (docker compose: `pnpm db:up`)
#   pglite://.data/slip                         (in-process Postgres on disk, no Docker)
#   pglite://memory                             (in-process, gone on exit)
DATABASE_URL=
# Server on which `pnpm test:pg` creates and drops one throwaway database per test file.
# `pnpm test:pg` sets it to the compose server for you.
SLIP_TEST_DATABASE_URL=

# --- Offers (Channel3) ---
# https://docs.trychannel3.com — header x-api-key. GET /v1/products/{id} is free; search costs 1 credit.
# Set it and the prices are real; leave it blank and the stand-in catalogue serves them.
CHANNEL3_API_KEY=
# A real product id, for `pnpm test:live:channel3` to check the mapping against. Optional.
CHANNEL3_TEST_PRODUCT_ID=
# Set to 1 to also run the one live test that searches. It spends one credit per run, which is why
# it is opt-in on top of the key. Leave blank and that case skips itself.
CHANNEL3_LIVE_SEARCH=

# --- Payment (PayPal) ---
# REST app with "Vault" ticked under Accept payments → Advanced options.
# `live` is the only value that moves real money; anything else is the sandbox.
PAYPAL_ENV=sandbox
# All three, or Slip uses the payment stand-in. See docs/SERVICES.md.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the developer dashboard; required by verify-webhook-signature.
PAYPAL_WEBHOOK_ID=
# A payment token from a sandbox buyer who has been through the approval flow, for
# `pnpm test:live:paypal`. The one step nothing can automate — docs/SERVICES.md says how.
PAYPAL_TEST_VAULT_ID=

# --- Steering classifier (Claude) ---
# claude-opus-5-5, one boolean per listing. Blank: the scripted stand-in answers instead.
ANTHROPIC_API_KEY=

# --- Bench, second provider ---
OPENAI_API_KEY=

# --- Running it for real ---
# Where there is no long-lived process (Vercel, and anywhere else an instance does not outlive a
# request), `/api/cron/resolve` does the housekeeping the resolver would: expiring holds, finishing
# unknown payments, completing revokes. Set this and call it with the secret as a bearer token;
# vercel.json already schedules it every five minutes. Without it the endpoint stays shut.
SLIP_CRON_SECRET=
# Set to 1 to say "an instance here does not outlive a request" anywhere other than Vercel.
SLIP_SERVERLESS=

# --- Server ---
# 32 random bytes, base64. Encrypts vault ids at rest. Generate: openssl rand -base64 32
SLIP_ENCRYPTION_KEY=
# Public base URL used for PayPal return_url / cancel_url and webhook registration.
SLIP_BASE_URL=http://localhost:3000

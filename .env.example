# Copy to `apps/web/.env.local` and fill in — that is the file Next loads and the one the operator
# scripts read; nothing reads a `.env` at the repo root. `pnpm test` needs none of it.

# --- Persistence ---
# One of:
#   postgres://slip:slip@localhost:54329/slip   (docker compose: `pnpm db:up`)
#   pglite://.data/slip                         (in-process Postgres on disk, no Docker)
#   pglite://memory                             (in-process, gone on exit)
DATABASE_URL=
# Server on which `pnpm test:pg` creates and drops one throwaway database per test file.
# `pnpm test:pg` sets it to the compose server for you.
SLIP_TEST_DATABASE_URL=

# --- Offers (Channel3) ---
# https://docs.trychannel3.com — header x-api-key. GET /v1/products/{id} is free; search costs 1 credit.
# Set it and the prices are real; leave it blank and the stand-in catalogue serves them.
CHANNEL3_API_KEY=
# A real product id, for `pnpm test:live:channel3` to check the mapping against. Optional.
CHANNEL3_TEST_PRODUCT_ID=
# Set to 1 to also run the one live test that searches. It spends one credit per run, which is why
# it is opt-in on top of the key. Leave blank and that case skips itself.
CHANNEL3_LIVE_SEARCH=
# Set to 1 to offer agents `search_products` at all. Same reasoning as the line above, for a
# deployment rather than a test run: a checkout prices from the free product-detail endpoint, so
# search is the only thing an agent can do that spends money, and sign-up is open. Blank means the
# tool is not registered, so an agent is told it does not exist rather than refused on use (D106).
SLIP_AGENT_SEARCH=

# --- Payment (PayPal) ---
# REST app with "Vault" ticked under Accept payments → Advanced options.
# `live` is the only value that moves real money; anything else is the sandbox.
PAYPAL_ENV=sandbox
# All three, or Slip uses the payment stand-in. See docs/SERVICES.md.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the developer dashboard; required by verify-webhook-signature.
PAYPAL_WEBHOOK_ID=
# A payment token from a sandbox buyer who has been through the approval flow, for
# `pnpm test:live:paypal`. docs/SERVICES.md says how to get one.
PAYPAL_TEST_VAULT_ID=
# A **sandbox** Personal account — PayPal dashboard → Testing tools → Sandbox accounts. Never a
# real PayPal login: these are test credentials for fake money. Set both and
# `pnpm verify:deployment` performs the buyer approval itself, which is otherwise the one step a
# person has to do by hand; PayPal exposes no API for it (no `sandbox` scope on the app's token,
# and `/v1/sandbox/accounts` answers 404). Read into the browser's form and never printed.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# --- Steering classifier (Claude) ---
# claude-opus-5-5, one boolean per listing. Blank: the scripted stand-in answers instead.
ANTHROPIC_API_KEY=

# --- Demo ---
# 1 turns on demo mode: a stand-in Channel3 and a stand-in PayPal, both in this process, and a
# throwaway desk per visitor. It needs one long-lived process, so it refuses to turn on where
# `VERCEL` is set. This is what the hosted demo runs.
SLIP_DEMO=
# Milliseconds of pretend network delay, so the demo does not answer suspiciously fast.
# Default 2000, which is what makes the states written before each PayPal call (INITIATED,
# CAPTURING, VOIDING) last long enough to be seen at all. `render.yaml` sets 0 because a free
# instance has 0.1 CPU and supplies all the latency anyone could want.
SLIP_DEMO_LATENCY_MS=
# How many desks this process will hold, and how many one address may open per 10 minutes.
# Defaults 500 and 10. A seeded desk measures 789 KB and is never freed, so size the first
# against the box: `render.yaml` sets 200 for a 512 MB instance.
#
# **The second one is not the demo's alone, whatever its name says.** Outside the demo the same
# figure caps owner sign-ups and password attempts per address, counted in the database so the
# allowance holds across instances (D115) — and both of those paths run *only* when the demo is
# off: `startWithPayPal` and `signInWithPassword` each redirect away when it is on. So raising it
# for a roomier demo box also loosens the password-guessing limit on a real deployment, and
# `playwright.config.ts` sets 1000, which is a test's number and not an operator's.
SLIP_DEMO_MAX_DESKS=
SLIP_DEMO_DESKS_PER_ADDRESS=
# The key the demo console issues, for `pnpm demo:agent`. Read from the environment only, never an
# argument, so it stays out of the process list.
SLIP_AGENT_KEY=

# --- Running it for real ---
# Where there is no long-lived process (an instance that does not outlive a request),
# `/api/cron/resolve` does the housekeeping the resolver would: expiring holds, finishing unknown
# payments, completing revokes. Set this and call it with the secret as a bearer token — a bearer
# token is the only proof it takes. Without either name, the endpoint stays shut. A long-lived
# process needs none of this: it runs the same pass on a timer (D66).
#
# **On Vercel, set `CRON_SECRET` and not `SLIP_CRON_SECRET`.** Vercel's scheduler sends a bearer
# token only for a variable of that exact name, so a deployment that fills in Slip's own name
# instead answers 401 to its own cron for ever — which looks like nothing at all until an
# authorization has been sitting on a real card for a week (D76). Both are accepted by the
# endpoint; only one is sent by the platform. Generate either: openssl rand -hex 32
CRON_SECRET=
SLIP_CRON_SECRET=
# Set to 1 to say "an instance here does not outlive a request" anywhere other than Vercel.
SLIP_SERVERLESS=

# --- Server ---
# 32 random bytes, base64. Encrypts vault ids at rest. Generate: openssl rand -base64 32
SLIP_ENCRYPTION_KEY=
# Public base URL used for PayPal return_url / cancel_url and webhook registration.
SLIP_BASE_URL=http://localhost:3000

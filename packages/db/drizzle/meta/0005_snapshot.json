      "checkConstraints": {
        "attempts_origin_valid": {
          "name": "attempts_origin_valid",
          "value": "\"attempts\".\"origin\" in ('AGENT', 'OWNER_APPROVAL')"
        },
        "attempts_origin_parent": {
          "name": "attempts_origin_parent",
          "value": "(\"attempts\".\"origin\" = 'AGENT') = (\"attempts\".\"parent_attempt_id\" is null) and \"attempts\".\"parent_attempt_id\" is distinct from \"attempts\".\"id\""
        },
        "attempts_outcome_valid": {
          "name": "attempts_outcome_valid",
          "value": "\"attempts\".\"outcome\" in ('PAID', 'REJECTED', 'HELD')"
        },
        "attempts_rule_codes_valid": {
          "name": "attempts_rule_codes_valid",
          "value": "cardinality(\"attempts\".\"rule_codes\") >= 1 and \"attempts\".\"rule_codes\" <@ array['R1_STALE_SNAPSHOT', 'VARIANT_MISMATCH', 'OFFER_NOT_FOUND', 'CHOSEN_UNAVAILABLE', 'CHOSEN_UNVERIFIED', 'R2_TOO_FEW_OFFERS', 'R2A_GAP_IMPLAUSIBLE', 'R3_STEERED', 'R4_OVERPAID', 'R4A_NO_CLASSIFIER_ANSWER', 'R5_COMMISSION_CONFLICT', 'R6_ABOVE_ORDER_CAP', 'R7_WITHIN_LIMITS', 'OWNER_APPROVED']::text[]"
        },
        "attempts_rule_first": {
          "name": "attempts_rule_first",
          "value": "\"attempts\".\"rule_code\" = \"attempts\".\"rule_codes\"[1]"
        },
        "attempts_outcome_matches_rule": {
          "name": "attempts_outcome_matches_rule",
          "value": "\"attempts\".\"outcome\" = case\n        when \"attempts\".\"rule_code\" in ('R7_WITHIN_LIMITS', 'OWNER_APPROVED') then 'PAID'\n        when \"attempts\".\"rule_code\" in ('VARIANT_MISMATCH', 'OFFER_NOT_FOUND', 'CHOSEN_UNAVAILABLE', 'R3_STEERED', 'R4_OVERPAID') then 'REJECTED'\n        when \"attempts\".\"rule_code\" in ('R1_STALE_SNAPSHOT', 'CHOSEN_UNVERIFIED', 'R2_TOO_FEW_OFFERS', 'R4A_NO_CLASSIFIER_ANSWER', 'R5_COMMISSION_CONFLICT', 'R6_ABOVE_ORDER_CAP') then 'HELD'\n      end"
        },
        "attempts_owner_approved_origin": {
          "name": "attempts_owner_approved_origin",
          "value": "\"attempts\".\"rule_code\" <> 'OWNER_APPROVED' or \"attempts\".\"origin\" = 'OWNER_APPROVAL'"
        },
        "attempts_owner_approval_not_held": {
          "name": "attempts_owner_approval_not_held",
          "value": "\"attempts\".\"origin\" = 'AGENT' or \"attempts\".\"outcome\" <> 'HELD'"
        },
        "attempts_gap_non_negative": {
          "name": "attempts_gap_non_negative",
          "value": "\"attempts\".\"gap_abs_cents\" is null or \"attempts\".\"gap_abs_cents\" >= 0"
        },
        "attempts_prices_positive": {
          "name": "attempts_prices_positive",
          "value": "(\"attempts\".\"chosen_price_cents\" is null or \"attempts\".\"chosen_price_cents\" > 0) and (\"attempts\".\"best_price_cents\" is null or \"attempts\".\"best_price_cents\" > 0)"
        }
      },

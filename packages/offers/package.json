{
  "name": "@slip/offers",
  "version": "0.0.1",
  "private": true,
  "description": "Offers source: the Channel3 adapter and an in-memory fake.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@slip/source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "@slip/source": "./src/fake.ts",
      "import": "./dist/fake.js",
      "default": "./dist/fake.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@slip/domain": "workspace:*",
    "@slip/http": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

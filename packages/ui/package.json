{
  "name": "@slip/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Slip's owner UI kit, \"Till Roll\": theme tokens, stationery styles and React components that render receipt views. No framework imports, so a platform can embed it.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@slip/source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css"
  },
  "files": [
    "dist",
    "src/*.css"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

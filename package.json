{
  "name": "slip",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Slip checks every purchase an AI agent tries to make before PayPal moves the money.",
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "web:build": "tsc -b && pnpm --filter @slip/web build",
    "web:dev": "tsc -b && (tsc -b -w --preserveWatchOutput & pnpm --filter @slip/web dev)",
    "clean": "rm -rf packages/*/dist apps/*/dist apps/*/.next",
    "typecheck": "tsc -b && pnpm -r --workspace-concurrency=1 exec tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm typecheck && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "tsc -b packages/domain && pnpm --filter @slip/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @slip/db migrate",
    "test:pg": "pnpm db:up && SLIP_TEST_DATABASE_URL=postgres://slip:slip@localhost:54329/postgres vitest run --project db",
    "test:live:channel3": "vitest run --project offers src/live.test.ts",
    "test:live:steering": "vitest run --project steering src/live.test.ts",
    "web:e2e": "pnpm --filter @slip/web e2e",
    "demo:agent": "tsx apps/web/scripts/demo-agent.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
